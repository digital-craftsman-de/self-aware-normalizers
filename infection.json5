{
  "$schema": "vendor/infection/infection/resources/schema.json",
  // The tests of the plan normalizer boot kernels and compare whole serializers, so the tests covering a mutant can take longer than
  // the default of 10 seconds. Mutants whose covering tests take longer than the timeout are skipped instead of tested.
  "timeout": 30,
  "source": {
    "directories": [
      "src"
    ],
    // Test cases for applications, test tooling like the tests themselves
    "excludes": [
      "Testing"
    ]
  },
  // Plan normalizer: by design, a mistake of the plan only makes a class slower, never different, as anything the plan doesn't handle
  // exactly falls back to the PropertyNormalizer. Some mutants therefore only change which path produces the (same) result. They are
  // ignored narrowly (mutator and method or source line) with the reason. Everything else is killed by tests.
  "mutators": {
    "@default": true,
    "IncrementInteger": {
      "ignore": [
        "DigitalCraftsman\\SelfAwareNormalizers\\Doctrine\\ArrayNormalizableType::convertToPHPValue",
        "DigitalCraftsman\\SelfAwareNormalizers\\Doctrine\\ArrayNormalizableThroughLookupType::convertToPHPValue"
      ]
    },
    "DecrementInteger": {
      "ignore": [
        "DigitalCraftsman\\SelfAwareNormalizers\\Doctrine\\ArrayNormalizableType::convertToPHPValue",
        "DigitalCraftsman\\SelfAwareNormalizers\\Doctrine\\ArrayNormalizableThroughLookupType::convertToPHPValue",
        // Output formatting: wrapped texts are one column narrower than the terminal
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::writeWrapped"
      ]
    },
    "Minus": {
      "ignore": [
        // Output formatting: wrapped texts are one column narrower than the terminal
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::writeWrapped"
      ]
    },
    "MethodCallRemoval": {
      "ignore": [
        "DigitalCraftsman\\SelfAwareNormalizers\\Doctrine\\Exception\\InvalidTypeName::__construct"
      ]
    },
    "Throw_": {
      "ignore": [
        // Without the throw, a value of the wrong type (the instance of FallbackIsRequired) is passed on to the constructor, which fails
        // with a TypeError, which falls back to the PropertyNormalizer as well
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::build",
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::buildNested",
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::buildNestedList",
        // Only reached when no normalizer of the serializer supports the class, which the framework's ObjectNormalizer prevents
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::denormalizeThroughSerializer",
        // Guard: symfony/type-info only allows int and string keys
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanFactory::keyCheck"
      ]
    },
    "Coalesce": {
      "ignoreSourceCodeByRegex": [
        // Memo lookups in front of the method that fills the memo: swapped, the plan or kind is computed from the memo anyway
        ".*\\$this->plans\\[.+\\] \\?\\? \\$this->plan\\(.*",
        ".*\\$this->normalizationKinds\\[\\$class\\] \\?\\? \\$this->normalizationKind\\(\\$class\\);"
      ]
    },
    "ReturnRemoval": {
      "ignore": [
        // Fast paths for null, scalars, arrays, value objects and planned objects: without them, the value goes through the serializer,
        // which returns the same (through the same normalizers)
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizeValue"
      ],
      "ignoreSourceCodeByRegex": [
        // Memo hit: without it, the plan is built again, with the same result
        "return \\$this->plans\\[\\$class\\];"
      ]
    },
    "LogicalOr": {
      "ignore": [
        // Fast path for null and scalars, see ReturnRemoval
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizeValue"
      ]
    },
    "LogicalAnd": {
      "ignore": [
        // Fast path for null and scalars: normalizeValue() returns them as they are
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizeObject",
        // The union member flag only changes how a failing denormalization fails, which falls back to the PropertyNormalizer anyway
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::contextOfObject",
        // The reason and the description of a limitation are always set together
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::writeDelegatedParameters",
        // The next token is only null after the last token, which is never a namespace or class keyword in valid PHP
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::classesDeclaredInDirectories"
      ]
    },
    "TrueValue": {
      "ignore": [
        // The serializer checks the union member flag with isset()
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::contextOfObject"
      ]
    },
    "MatchArmRemoval": {
      "ignore": [
        // Without the arms, value objects and planned objects are normalized through the serializer, with the same result
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizationKind"
      ]
    },
    "LogicalAndAllSubExprNegation": {
      "ignore": [
        // Objects normalized directly through the plan or through the serializer (which selects the plan normalizer) have the same result
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizationKind"
      ]
    },
    "LogicalAndSingleSubExprNegation": {
      "ignore": [
        // See LogicalAndAllSubExprNegation
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::normalizationKind"
      ]
    },
    "UnwrapFinally": {
      "ignore": [
        // PlanFactory::create() doesn't throw for an existing class (see its failure contract)
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::createPlan"
      ]
    },
    "FalseValue": {
      "ignore": [
        // Whether another class has a plan only decides the kind of a parameter, never a limitation, which is all diagnose() reads
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::diagnose",
        // A class of a recursion: its own plan is discarded as recursive either way, the classes referencing it get the same plan
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::hasPlanOutsideOfRecursion"
      ]
    },
    "CastBool": {
      "ignore": [
        // The values are only used as conditions, the cast doesn't change their truthiness
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanNormalizer::isContextSupported",
        // Options without value (InputOption::VALUE_NONE) are always bool
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "LogicalOrAllSubExprNegation": {
      "ignore": [
        // A class that can't be loaded is never in the scope, so it's skipped either way
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "LogicalOrSingleSubExprNegation": {
      "ignore": [
        // See LogicalOrAllSubExprNegation
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "NullSafePropertyCall": {
      "ignore": [
        // The class of a delegated parameter has no plan, so it always has a limitation
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "NullSafeMethodCall": {
      "ignore": [
        // See NullSafePropertyCall
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "BitwiseOr": {
      "ignore": [
        // Output formatting of the JSON (pretty print, unescaped slashes)
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::execute"
      ]
    },
    "UnwrapLtrim": {
      "ignore": [
        // Only changes the name of a class in the global namespace, which isn't autoloadable and therefore skipped either way
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::classesDeclaredInDirectories"
      ]
    },
    "UnwrapArrayUnique": {
      "ignore": [
        // Guard, a class is only declared once
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\ListUnplannedClassesCommand::classesDeclaredInDirectories"
      ]
    },
    "Catch_": {
      "ignore": [
        // Guard: the type resolution only throws exceptions of type-info for the existing classes of a constructor
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanFactory::createParameterPlan"
      ]
    },
    "FunctionCallRemoval": {
      "ignore": [
        // type-info orders the members of a union of key types, the sorting only guards against a change of that
        "DigitalCraftsman\\SelfAwareNormalizers\\Serializer\\PlanNormalizer\\PlanFactory::keyCheck"
      ]
    }
  },
  "minMsi": 100,
  "minCoveredMsi": 100
}
